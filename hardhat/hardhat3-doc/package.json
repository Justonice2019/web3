{
  "name": "my-hardhat3-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy:all": "npm run ignition:deploy:vault:localhost && npm run ignition:deploy:test:localhost",
    "node": "hardhat node",
    "test": "npm run clean && npm run deploy:all && hardhat test",
    "test:counter": "hardhat test test/Counter/Counter.ts",
    "test:counter.test": "hardhat test test/Counter/Counter.test.ts",
    "test:vault": "hardhat test ./test/Vault.ts",
    "test:CrowdfundingCampaign": "hardhat test ./test/CrowdfundingCampaign/CrowdfundingCampaign.test.ts",
    "coverage": "npm run clean && npm run deploy:all && hardhat test --coverage",
    "gas": "npm run clean && npm run deploy:all && hardhat test --gas-stats",
    "run:send-op-tx": "hardhat run scripts/send-op-tx.ts",
    "run:Vault:localhost": "hardhat run scripts/Vault.ts --network localhost",
    "run:Test:localhost": "hardhat run scripts/Test.ts --network localhost",
    "ignition:deploy:counter": "hardhat ignition deploy ./ignition/modules/Counter.ts",
    "ignition:deploy:counter:sepolia": "hardhat ignition deploy ./ignition/modules/Counter.ts --network sepolia",
    "ignition:deploy:vault": "hardhat ignition deploy ./ignition/modules/Vault.ts",
    "ignition:deploy:vault:hardhatMainnet": "hardhat ignition deploy ./ignition/modules/Vault.ts --network hardhatMainnet  --parameters ./ignition/parameters/hardhatMainnet.json",
    "ignition:deploy:vault:hardhatOp": "hardhat ignition deploy ./ignition/modules/Vault.ts --network hardhatOp --parameters ./ignition/parameters/hardhatOp.json",
    "ignition:deploy:vault:localhost": "hardhat ignition deploy ./ignition/modules/Vault.ts --network localhost --parameters ./ignition/parameters/localhost.json",
    "ignition:deploy:test:localhost": "hardhat ignition deploy ./ignition/modules/Test.ts --network localhost --parameters ./ignition/parameters/localhost.json",
    "ignition:deploy:example:sepolia": "hardhat ignition deploy ./ignition/modules/Example.ts --network sepolia",
    "ignition:check:status": "hardhat ignition status chain-11155111",
    "ignition:check:verify": "hardhat ignition verify chain-11155111 --network sepolia",
    "ignition:deploy:crowdfundingFactory": "hardhat ignition deploy ./ignition/modules/CrowdfundingFactory.ts --network sepolia",
    "MetaNodeStake:deploy-to-local-with-hardhat": "hardhat run ./scripts/projects/MetaNodeStake/deploy-to-local-with-hardhat.ts --network localhost",
    "MetaNodeStake:deploy-to-local-with-ethers": "node ./scripts/projects/MetaNodeStake/deploy-to-local-with-ethers.ts",
    "MetaNodeStake:deploy-to-sepolia-with-ethers": "node ./scripts/projects/MetaNodeStake/deploy-to-sepolia-with-ethers.ts",
    "MetaNodeStake:test": "hardhat test test/projects/MetaNodeStake/MetaNodeStake.test.ts",
    "MetaNode:test": "hardhat test test/projects/MetaNodeStake/MetaNode.test.ts",
    "MetaNode:ignition:deploy:sepolia": "hardhat ignition deploy ./ignition/modules/projects/MetaNodeStake/MetaNode.ts --network sepolia"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.7",
    "@nomicfoundation/hardhat-ignition": "^3.1.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "chai": "^6.2.2",
    "dotenv": "^17.4.1",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.3.0",
    "mocha": "^11.7.5",
    "typescript": "~5.8.0"
  },
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "dayjs": "^1.11.20"
  }
}
